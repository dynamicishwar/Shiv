# Copy this file to ".env" (same folder) and fill in what you have.
# .env stays on your machine — never commit or share it.

# Claude (the brain). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# HeyGen LiveAvatar (the photorealistic face). Get a key at https://app.liveavatar.com
# Leave blank to use the free local orb + Windows voice instead.
LIVEAVATAR_API_KEY=
# true = free 1-minute test sessions with the sandbox avatar (no avatar id needed)
LIVEAVATAR_SANDBOX=true
# For real sessions: set SANDBOX=false and pick an avatar/voice from your LiveAvatar account
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_CONTEXT_ID=
